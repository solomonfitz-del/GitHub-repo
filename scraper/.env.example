# Google Places API Key
# Get yours from https://console.cloud.google.com/apis/credentials
# Enable the "Places API" in your GCP project.
# Format: AIzaSy...
GOOGLE_PLACES_API_KEY=

# Default search parameters
DEFAULT_LOCATION=San Francisco, CA
DEFAULT_RADIUS=50000
DEFAULT_CATEGORY=restaurant
DEFAULT_MAX_RESULTS=50

# Team database (set automatically by team-db env vars)
# TEAM_DB_PATH=/home/team/.data/agent-team-783497d6.db